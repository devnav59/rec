<resources>
    <string name="app_name">دیدبان عدد صفحه</string>
    <string name="title">پایش یک عدد روی صفحه</string>
    <string name="subtitle">یک نشانه را پیدا کنید؛ عدد نزدیک آن روی خود گوشی خوانده می‌شود و فقط تغییرهای تأییدشده اعلام می‌شوند.</string>
    <string name="privacy_notice">ضبط صفحه فقط پس از تأیید پنجرهٔ سیستمی اندروید شروع می‌شود. فریم‌ها روی همین گوشی پردازش می‌شوند و برنامه آن‌ها را آپلود یا ذخیره نمی‌کند. هنگام پایش، اعلان دائمی و دکمهٔ توقف پنجرهٔ شناور قابل مشاهده‌اند.</string>
    <string name="section_anchor">۱. نشانه را انتخاب کنید</string>
    <string name="mode_text">متن / نماد خوانا با OCR</string>
    <string name="mode_image">تصویر یک نماد</string>
    <string name="marker_hint">متن یا نماد نشانه (مثلاً HP یا ★)</string>
    <string name="marker_help">اگر خود نماد با OCR خوانده نمی‌شود، برچسب متنی نزدیک آن را وارد کنید.</string>
    <string name="choose_image">انتخاب تصویر برش‌خوردهٔ نماد</string>
    <string name="no_image_selected">تصویری برای نماد انتخاب نشده است</string>
    <string name="image_help">یک برش نزدیک از نماد، با همان اندازه‌ای که روی صفحه دیده می‌شود انتخاب کنید. تطبیق تصویر روی خود گوشی انجام می‌شود.</string>
